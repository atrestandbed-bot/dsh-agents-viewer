{
  "name": "dsh-agents-viewer",
  "version": "0.7.0",
  "type": "module",
  "description": "查看并编辑全局、共享与项目级的 AGENTS.md：右侧栏原生 tab + 头部按钮 + /agents 命令",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agents-md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atrestandbed-bot/dsh-agents-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/atrestandbed-bot/dsh-agents-viewer/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./runtime/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "runtime/client.js",
    "runtime/override.css",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "check": "node scripts/check-compat.mjs",
    "adapt": "node scripts/adapt-dsh.mjs",
    "adapt:install": "node scripts/adapt-dsh.mjs --install"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
